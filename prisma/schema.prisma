generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model PendingUser {
  // id            String   @id @default(uuid(7)) @db.Uuid
  id String @id @default(auto()) @map("_id") @db.ObjectId

  email     String   @unique
  password  String
  role      UserRole
  fullName  String
  fcmToken  String?
  timeZone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pending_users")
}

model User {
  // id                    String            @id @default(uuid(7)) @db.Uuid
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  email                 String?        @unique
  password              String?
  role                  UserRole
  fullName              String?
  timeZone              String?
  choosenHero           String?
  morningReminder       String?
  nightReminder         String?
  starEarned            Int            @default(0)
  fcmTokens             String[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lastLoginAt           DateTime       @default(now())
  profileImage          String?
  appleId               String?
  loginType             UserLoginType  @default(EMAIL_PASS)
  receivedNotifications Notification[] @relation("notificationRecieve")
  sentNotifications     Notification[] @relation("notificationSend")
  sessions              Session[]

  @@index([appleId])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

enum UserLoginType {
  GOOGLE
  APPLE
  EMAIL_PASS
}

model Notification {
  // id                  String              @id @default(uuid(7)) @db.Uuid
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  body                String?
  // receiverId          String?             @db.Uuid
  receiverId          String?             @db.ObjectId
  // senderId            String?             @db.Uuid
  senderId            String?             @db.ObjectId
  type                NotificationType
  isRead              Boolean             @default(false)
  notificationChannel NotificationChannel @default(BOTH)
  metaData            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  receiver            User?               @relation("notificationRecieve", fields: [receiverId], references: [id], onDelete: Cascade)
  sender              User?               @relation("notificationSend", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([isRead])
  @@map("notifications")
}

enum NotificationChannel {
  INAPP
  PUSH
  BOTH
}

enum NotificationType {
  SYSTEM
  MORNING_REMINDER
  NIGHT_REMINDER
  POINT // points added
}

model Session {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  type      SessionType
  userId    String      @db.ObjectId
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, dateKey, type])
  @@index([createdAt])
  @@map("sessions")
}

model level {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  requiredStars Int
  order         Int      @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("levels")
}

enum SessionType {
  MORNING
  NIGHT
}
