### change password

PATCH {{baseUrl}}/auth/change-pass HTTP/1.1
Authorization: {{jabir}}

{
  "newPassword": "Aw32@320",
  "oldPassword": "Aw32@320"
}


### send forgot pass otp

POST {{baseUrl}}/auth/send-forgot-otp HTTP/1.1
Content-Type: application/json

{
  "email": "imran@gmail.com"
}


### verify forgot pass otp

POST {{baseUrl}}/auth/verify-forgot-otp HTTP/1.1
Content-Type: application/json

{
  "email": "mir@gmail.com",
  "otp": "2980"
}


### reset password

POST {{baseUrl}}/auth/reset-password HTTP/1.1
Authorization: {{forgotToken}}
Content-Type: application/json

{
  "newPassword": "Abc123!@"
}


### fetch my profile

GET {{baseUrl}}/auth/me HTTP/1.1
Authorization: {{jabir}}


### update my profile

PATCH {{baseUrl}}/auth/me/update HTTP/1.1
Authorization: {{jabir}}
Content-Type: application/json

{
  "choosenHero": "Iron Man",
  "fullName": "Jabir Bin Hasan",
  "morningReminder": "08:00",
  "nightReminder": "22:30",
  "timeZone": "Asia/Dhaka"
}


### delete my account

DELETE {{baseUrl}}/auth/delete-account HTTP/1.1
Authorization: {{jabir}}


### update profile image

PATCH {{baseUrl}}/auth/update-profile-image HTTP/1.1
Authorization: {{jabir}}
Content-Type: application/form-data

{
  "profileImage": "upload from postman"
}
